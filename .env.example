# Django Environment Configuration
DEBUG=1
SECRET_KEY=replace-with-a-long-random-django-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Database (Optional for Docker deployment)
POSTGRES_DB=rayara
POSTGRES_USER=rayara
POSTGRES_PASSWORD=replace-with-a-long-random-password
# DATABASE_URL=postgres://rayara:replace-with-a-long-random-password@localhost:5432/rayara

# Free Email OTP Configuration (Resend API - Recommended)
# 1. Sign up at https://resend.com
# 2. Get an API key from https://resend.com/api-keys
# 3. Add your key below:
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Rayara Café <onboarding@resend.dev>

# Optional SMTP Fallback (e.g. Gmail App Password)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
